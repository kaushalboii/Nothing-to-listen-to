{
  "manifest_version": 3,
  "name": "NTLT Personal Ad-Shield",
  "version": "1.0.0",
  "description": "Personal ad blocker for Nothing to Listen To and YouTube",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
